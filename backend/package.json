{
  "name": "medivault-backend",
  "version": "1.0.0",
  "description": "MediVault - Smart & Secure Personal Health Management System Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test_mvp.js",
    "test:rbac": "node test_rbac.js",
    "test:ai": "node --test test_ai_summary.js",
    "test:unit": "node --test test_security.js test_ai_summary.js test_insurance_plan_assistant.js test_medicine_catalog_search.js test_storage_security.js test_ai_provider.js",
    "test:all": "npm run test:unit && node test_mvp.js && node test_rbac.js",
    "admin:promote": "node src/scripts/promoteAdmin.js",
    "policies:clear-legacy-demo": "node src/scripts/clearLegacyDemoPolicyEnrollments.js",
    "test:storage": "node --test test_storage_integration.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  }
}
