PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/medivault
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional directory for legacy/demo files only. New uploads use MongoDB GridFS.
# UPLOAD_DIR=
# Local-only medical document summaries. The backend rejects non-loopback Ollama URLs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
