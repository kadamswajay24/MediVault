PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/medivault
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional directory for legacy/demo files only. New uploads use MongoDB GridFS.
# UPLOAD_DIR=
# Set GEMINI_API_KEY only in backend secrets. Its presence selects Gemini automatically.
# AI_PROVIDER=gemini or ollama overrides automatic selection. Never use VITE_ for keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Application caps, not a guarantee of Google's project quota or free-tier eligibility.
AI_USER_REQUESTS_PER_MINUTE=5
AI_USER_REQUESTS_PER_DAY=20
AI_GLOBAL_REQUESTS_PER_MINUTE=10
AI_GLOBAL_REQUESTS_PER_DAY=100
# Without a Gemini key, use loopback-only Ollama for local development.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
